{
  "version": 1,
  "passes": [
    {
      "name": "trail",
      "fragment": {"file": "feedback.glsl"},
      "channels": [{"buffer": "trail"}],
      "params": {
        "decay": {"type": "float", "value": 0.97, "min": 0.8, "max": 0.999, "step": 0.001},
        "zoom": {"type": "float", "value": 0.985, "min": 0.95, "max": 1.05, "step": 0.001},
        "spin": {"type": "float", "value": 0.02, "min": -0.1, "max": 0.1, "step": 0.001},
        "speed": {"type": "float", "value": 1.6, "min": 0.0, "max": 6.0, "step": 0.1}
