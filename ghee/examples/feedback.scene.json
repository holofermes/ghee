    {
      "name": "image",
      "fragment": "void main() {\n  float v = texture2D(iChannel0, uv).r;\n  vec3 col = mix(background, wake, v);\n  gl_FragColor = vec4(mix(col, crest, smoothstep(0.75, 1.0, v)), 1.0);\n}\n",
      "channels": [{"buffer": "trail"}],
      "params": {
        "background": {"type": "color", "value": [0.02, 0.02, 0.05]},
        "wake": {"type": "color", "value": [0.15, 0.45, 0.85]},
        "crest": {"type": "color", "value": [1.0, 0.85, 0.6]}
      }
    }
  ]
}
